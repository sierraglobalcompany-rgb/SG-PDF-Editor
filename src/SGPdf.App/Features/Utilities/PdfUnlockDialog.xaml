<Window x:Class="SGPdf.App.Features.Utilities.PdfUnlockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desbloquear PDF"
        Width="500" Height="350"
        MinWidth="470" MinHeight="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Contraseña actual del PDF"
                   FontWeight="SemiBold" />
        <PasswordBox x:Name="CurrentPasswordBox"
                     Grid.Row="1"
                     Margin="0,6,0,14"
                     Padding="8,5" />

        <CheckBox x:Name="AuthorizationCheckBox"
                  Grid.Row="2"
                  Margin="0,0,0,12"
                  Content="Confirmo que estoy autorizado para crear una copia sin contraseña." />

        <StackPanel Grid.Row="3">
            <TextBlock Foreground="DimGray"
                       TextWrapping="Wrap"
                       Text="La contraseña se solicita de nuevo y no se guarda. Se creará un PDF nuevo; el original y sus firmas no se modifican." />
            <TextBlock x:Name="ValidationText"
                       Margin="0,10,0,0"
                       Foreground="Firebrick"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Continuar..." IsDefault="True" Padding="14,6" Click="Accept_Click" />
        </StackPanel>
    </Grid>
</Window>
