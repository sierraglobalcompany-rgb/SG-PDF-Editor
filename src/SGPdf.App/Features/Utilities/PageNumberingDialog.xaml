<Window x:Class="SGPdf.App.Features.Utilities.PageNumberingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numerar páginas / Bates"
        Width="540" Height="700"
        MinWidth="520" MinHeight="670"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Número inicial" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="StartNumberTextBox" Padding="6,3" Text="1" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Relleno mínimo" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="PaddingTextBox" Padding="6,3" Text="1" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Prefijo" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="PrefixTextBox" Padding="6,3" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Sufijo" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="SuffixTextBox" Padding="6,3" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Páginas" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="ScopeComboBox" SelectedIndex="0" SelectionChanged="ScopeComboBox_SelectionChanged">
                    <ComboBoxItem Content="Todas" Tag="All" />
                    <ComboBoxItem Content="Página actual" Tag="Current" />
                    <ComboBoxItem Content="Rango" Tag="Range" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Posición" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="AnchorComboBox" SelectedIndex="4">
                    <ComboBoxItem Content="Encabezado izquierda" Tag="HeaderLeft" />
                    <ComboBoxItem Content="Encabezado centro" Tag="HeaderCenter" />
                    <ComboBoxItem Content="Encabezado derecha" Tag="HeaderRight" />
                    <ComboBoxItem Content="Pie izquierda" Tag="FooterLeft" />
                    <ComboBoxItem Content="Pie centro" Tag="FooterCenter" />
                    <ComboBoxItem Content="Pie derecha" Tag="FooterRight" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <StackPanel x:Name="RangePanel" Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,14" Visibility="Collapsed">
            <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox x:Name="StartPageTextBox" Width="60" Padding="6,3" Text="1" />
            <TextBlock Text="hasta" VerticalAlignment="Center" Margin="12,0,6,0" />
            <TextBox x:Name="EndPageTextBox" Width="60" Padding="6,3" Text="1" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tamaño de fuente" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="FontSizeTextBox" Padding="6,3" Text="11" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Opacidad (0–100 %)" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBox x:Name="OpacityTextBox" Padding="6,3" Text="100" />
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="5" Text="Color RGB" FontWeight="SemiBold" Margin="0,0,0,6" />
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,14">
            <TextBlock Text="R" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="RedTextBox" Width="58" Padding="6,3" Text="0" />
            <TextBlock Text="G" VerticalAlignment="Center" Margin="14,0,4,0" />
            <TextBox x:Name="GreenTextBox" Width="58" Padding="6,3" Text="0" />
            <TextBlock Text="B" VerticalAlignment="Center" Margin="14,0,4,0" />
            <TextBox x:Name="BlueTextBox" Width="58" Padding="6,3" Text="0" />
        </StackPanel>

        <StackPanel Grid.Row="7" Margin="0,0,0,14">
            <TextBlock Text="Capa" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="LayerComboBox" SelectedIndex="1" Width="220" HorizontalAlignment="Left">
                <ComboBoxItem Content="Detrás del contenido" Tag="Background" />
                <ComboBoxItem Content="Encima del contenido" Tag="Foreground" />
            </ComboBox>
        </StackPanel>

        <TextBlock Grid.Row="8"
                   Text="La numeración avanza solo por las páginas seleccionadas. Se guardará una copia nueva."
                   Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,10" />
        <TextBlock x:Name="ValidationText" Grid.Row="9" Foreground="Firebrick" TextWrapping="Wrap" />

        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Continuar..." IsDefault="True" Padding="14,6" Click="Accept_Click" />
        </StackPanel>
    </Grid>
</Window>
