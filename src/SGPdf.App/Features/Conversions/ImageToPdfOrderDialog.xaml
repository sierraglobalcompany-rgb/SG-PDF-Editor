<Window x:Class="SGPdf.App.Features.Conversions.ImageToPdfOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Orden de las imágenes"
        Width="560" Height="430"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,12"
                   Text="Las páginas del PDF seguirán este orden. Selecciona una imagen y muévela si hace falta."
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" MinHeight="180">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="ImageOrderListBox"
                     Margin="0,0,12,0"
                     AutomationProperties.Name="Orden de las imágenes"
                     SelectionChanged="ImageOrderListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Directory}" FontSize="11" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                <Button x:Name="MoveUpButton"
                        Content="Subir"
                        AutomationProperties.Name="Subir imagen en el orden"
                        MinWidth="84"
                        Margin="0,0,0,8"
                        Padding="10,5"
                        Click="MoveUp_Click" />
                <Button x:Name="MoveDownButton"
                        Content="Bajar"
                        AutomationProperties.Name="Bajar imagen en el orden"
                        MinWidth="84"
                        Padding="10,5"
                        Click="MoveDown_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2"
                    Margin="0,14,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Cancelar"
                    IsCancel="True"
                    MinWidth="92"
                    Margin="0,0,8,0"
                    Padding="12,6" />
            <Button Content="Continuar"
                    IsDefault="True"
                    MinWidth="100"
                    Padding="12,6"
                    Click="Continue_Click" />
        </StackPanel>
    </Grid>
</Window>
