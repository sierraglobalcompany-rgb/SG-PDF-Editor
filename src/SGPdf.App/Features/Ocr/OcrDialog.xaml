<Window x:Class="SGPdf.App.Features.Ocr.OcrDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR / Hacer PDF buscable"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Width="430" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Convierte páginas escaneadas en PDF buscable usando OCR local."
                   TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Idioma" />
            <ComboBox x:Name="OcrLanguageComboBox"
                      Grid.Column="1"
                      MinWidth="220"
                      SelectedIndex="0">
                <ComboBoxItem Content="Español" />
                <ComboBoxItem Content="Inglés" />
                <ComboBoxItem Content="Español + Inglés" />
            </ComboBox>

            <TextBlock Grid.Row="1"
                       Margin="0,10,0,0"
                       VerticalAlignment="Center"
                       Text="Páginas" />
            <ComboBox x:Name="OcrScopeComboBox"
                      Grid.Row="1"
                      Grid.Column="1"
                      MinWidth="220"
                      Margin="0,10,0,0"
                      SelectedIndex="0">
                <ComboBoxItem Content="Automático" />
                <ComboBoxItem Content="Página actual" />
                <ComboBoxItem Content="Rango" />
            </ComboBox>
        </Grid>

        <StackPanel x:Name="OcrRangePanel"
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="120,10,0,0">
            <TextBlock VerticalAlignment="Center" Text="Desde" />
            <TextBox x:Name="OcrRangeStartTextBox"
                     Width="58"
                     Margin="8,0,14,0"
                     Padding="5,3" />
            <TextBlock VerticalAlignment="Center" Text="Hasta" />
            <TextBox x:Name="OcrRangeEndTextBox"
                     Width="58"
                     Margin="8,0,0,0"
                     Padding="5,3" />
        </StackPanel>

        <TextBlock x:Name="OcrValidationText"
                   Grid.Row="3"
                   Margin="0,10,0,0"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="4" Margin="0,16,0,0">
            <ProgressBar x:Name="OcrProgressBar"
                         Height="16"
                         Minimum="0"
                         Maximum="1"
                         Value="0" />
            <TextBlock x:Name="OcrProgressText"
                       Margin="0,6,0,0"
                       Text="Listo para iniciar. El destino se elegirá con Guardar como." />
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="OcrCancelButton"
                    Content="Cancelar"
                    MinWidth="88"
                    Padding="10,5"
                    Margin="0,0,8,0"
                    Click="OcrCancelButton_Click" />
            <Button x:Name="OcrStartButton"
                    Content="Guardar como y ejecutar OCR"
                    MinWidth="190"
                    Padding="10,5"
                    IsDefault="True"
                    Click="OcrStartButton_Click" />
        </StackPanel>
    </Grid>
</Window>
