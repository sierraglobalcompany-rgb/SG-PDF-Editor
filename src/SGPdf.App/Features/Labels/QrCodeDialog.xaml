<Window x:Class="SGPdf.App.Features.Labels.QrCodeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar código QR"
        Width="500" Height="280"
        MinWidth="460" MinHeight="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Texto o URL para el código QR"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8" />

        <TextBox x:Name="ValueTextBox"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Padding="8"
                 Margin="0,0,0,10" />

        <TextBlock x:Name="ValidationText"
                   Grid.Row="2"
                   Foreground="Firebrick"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancelar" IsCancel="True" Padding="14,6" Margin="0,0,8,0" />
            <Button Content="Continuar..." IsDefault="True" Padding="14,6" Click="Accept_Click" />
        </StackPanel>
    </Grid>
</Window>
