<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\SGPdf.App.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\SGPdf.App.ico" />
    <Resource Include="Assets\SGPdf.Document.ico" />
    <Resource Include="Assets\SGPdf.Document.png" />
    <Resource Include="Assets\HomeTools\*.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="bblanchon.PDFium.Win32" Version="156.0.8076" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)..\..\third_party\fonts\dejavu\DejaVuSans.ttf"
             Link="fonts\DejaVuSans.ttf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\runtime\labelize\labelize.exe')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\third_party\runtime\labelize\labelize.exe"
             Link="labelize\labelize.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\runtime\qpdf\qpdf.exe')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\third_party\runtime\qpdf\**\*"
             Link="qpdf\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\third_party\runtime\tesseract\tesseract.exe')">
    <Content Include="$(MSBuildThisFileDirectory)..\..\third_party\runtime\tesseract\**\*"
             Link="tesseract\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
