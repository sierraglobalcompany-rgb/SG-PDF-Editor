<Window x:Class="SGPdf.App.PdfPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDF protegido"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PdfPasswordMessageText"
                   Width="340"
                   TextWrapping="Wrap"
                   Text="Este PDF está protegido. Escribe la contraseña para abrirlo." />

        <PasswordBox x:Name="PdfPasswordBox"
                     Grid.Row="1"
                     Width="340"
                     Margin="0,14,0,0"
                     Padding="8,5"
                     PasswordChar="●"
                     KeyDown="PdfPasswordBox_KeyDown" />

        <TextBlock x:Name="PdfPasswordErrorText"
                   Grid.Row="2"
                   Width="340"
                   Margin="0,8,0,0"
                   Foreground="DarkRed"
                   TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="PdfPasswordCancelButton"
                    Content="Cancelar"
                    MinWidth="86"
                    Padding="10,5"
                    Margin="0,0,8,0"
                    Click="PdfPasswordCancelButton_Click" />
            <Button x:Name="PdfPasswordOkButton"
                    Content="Abrir"
                    MinWidth="86"
                    Padding="10,5"
                    IsDefault="True"
                    Click="PdfPasswordOkButton_Click" />
        </StackPanel>
    </Grid>
</Window>
