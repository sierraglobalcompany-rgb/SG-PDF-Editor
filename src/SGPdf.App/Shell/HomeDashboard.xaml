<UserControl x:Class="SGPdf.App.Shell.HomeDashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="96" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="HomeRail"
                Grid.Column="0"
                Width="96"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid Margin="0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0"
                        Style="{DynamicResource SgRailItemSelectedStyle}"
                        Margin="0,3"
                        Padding="0,8"
                        AutomationProperties.Name="Inicio"
                        Click="HomeRailInicio_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.5"
                              Data="{DynamicResource ShellIconHome}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" Text="Inicio" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="1"
                        Style="{DynamicResource SgRailItemStyle}"
                        Margin="0,3"
                        Padding="0,8"
                        AutomationProperties.Name="Herramientas"
                        Click="HomeRailTools_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.5"
                              Data="{DynamicResource ShellIconTools}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" Text="Herramientas" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="2"
                        Style="{DynamicResource SgRailItemStyle}"
                        Margin="0,3"
                        Padding="0,8"
                        AutomationProperties.Name="Recientes"
                        Click="HomeRailRecent_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.5"
                              Data="{DynamicResource ShellIconRecent}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" Text="Recientes" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
                <Button Grid.Row="4"
                        Style="{DynamicResource SgRailItemStyle}"
                        Margin="0,3"
                        Padding="0,8"
                        AutomationProperties.Name="Configuración"
                        ToolTip="Próximamente"
                        IsEnabled="False">
                    <StackPanel HorizontalAlignment="Center">
                        <Path Width="18"
                              Height="18"
                              Stretch="Uniform"
                              Stroke="{DynamicResource TextFillColorPrimaryBrush}"
                              StrokeThickness="1.5"
                              Data="{DynamicResource ShellIconSettings}" />
                        <TextBlock Margin="0,4,0,0" FontSize="11.5" Text="Configuración" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <Border x:Name="HomeHero"
                        Style="{DynamicResource SgContextPanelStyle}"
                        Margin="0,0,0,24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="¡Bienvenido a SG PDF Editor!"
                                   Style="{DynamicResource SgTitleTextStyle}" />
                        <TextBlock Grid.Row="1"
                                   Margin="0,8,0,16"
                                   Text="Edita y organiza tus documentos de forma local y offline."
                                   Style="{DynamicResource SgSubtitleTextStyle}" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Button x:Name="HomeOpenPdfButton"
                                    Content="Abrir PDF"
                                    Style="{DynamicResource SgPrimaryButtonStyle}"
                                    AutomationProperties.Name="Abrir PDF"
                                    Click="OpenPdf_Click" />
                            <Button x:Name="HomeOpenZplButton"
                                    Margin="8,0,0,0"
                                    Content="Abrir ZPL"
                                    Style="{DynamicResource SgSecondaryButtonStyle}"
                                    AutomationProperties.Name="Abrir ZPL"
                                    Click="OpenZpl_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel x:Name="HomeToolsSection" Margin="0,0,0,24">
                    <TextBlock Text="Herramientas" Style="{DynamicResource SgSectionHeaderStyle}" FontSize="20" />
                    <ItemsControl x:Name="HomeToolsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="280"
                                        Height="92"
                                        Margin="0,0,12,12"
                                        Padding="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ToolTip="{Binding DisabledReason}"
                                        Click="ToolCard_Click">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type Button}">
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ActionId}" Value="{x:Null}">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Border Style="{DynamicResource SgHomeCardStyle}"
                                            Margin="0"
                                            MinWidth="0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0"
                                                   Width="56"
                                                   Height="56"
                                                   Margin="0,0,12,0"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform"
                                                   Source="{Binding HomeIconPath}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Description}"
                                                           Margin="0,4,0,0"
                                                           Style="{DynamicResource SgMutedTextStyle}"
                                                           MaxHeight="36" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel x:Name="HomeRecentSection">
                    <TextBlock Text="Archivos recientes" Style="{DynamicResource SgSectionHeaderStyle}" FontSize="20" />
                    <Grid Margin="12,0,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nombre" Style="{DynamicResource SgMutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="Ubicación" Style="{DynamicResource SgMutedTextStyle}" />
                        <TextBlock Grid.Column="2" Text="Fecha" Margin="12,0" Style="{DynamicResource SgMutedTextStyle}" />
                        <TextBlock Grid.Column="3" Text="Tamaño" Style="{DynamicResource SgMutedTextStyle}" />
                    </Grid>
                    <ItemsControl x:Name="HomeRecentItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,0,6"
                                        Padding="12,8"
                                        HorizontalContentAlignment="Stretch"
                                        Background="Transparent"
                                        AutomationProperties.Name="{Binding AccessibleName}"
                                        Click="RecentPdf_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Grid.Column="0"
                                                   Width="20"
                                                   Height="20"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   Stretch="Uniform"
                                                   Source="/SGPdf.App;component/Assets/SGPdf.Document.png" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Location}" TextTrimming="CharacterEllipsis" Style="{DynamicResource SgMutedTextStyle}" />
                                        <TextBlock Grid.Column="2" Text="{Binding LastOpened}" Margin="12,0" Style="{DynamicResource SgMutedTextStyle}" />
                                        <TextBlock Grid.Column="3" Text="{Binding Size}" Style="{DynamicResource SgMutedTextStyle}" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="HomeRecentEmptyText"
                               Text="No hay archivos recientes todavía."
                               Style="{DynamicResource SgMutedTextStyle}"
                               Margin="12,8"
                               Visibility="Visible" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
