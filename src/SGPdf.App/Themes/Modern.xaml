<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      SG PDF visual layer.
      Native WPF Fluent resources are loaded by Application.ThemeMode=System.
      Keep this dictionary small: aliases + reusable variants only.
    -->

    <SolidColorBrush x:Key="SgSurfaceBrush"
                     Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="SgPanelBrush"
                     Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="SgCanvasBrush"
                     Color="{DynamicResource LayerFillColorDefault}" />
    <SolidColorBrush x:Key="SgBorderBrush"
                     Color="{DynamicResource CardStrokeColorDefault}" />
    <SolidColorBrush x:Key="SgAccentBrush"
                     Color="{StaticResource SystemAccentColor}" />
    <SolidColorBrush x:Key="SgMutedTextBrush"
                     Color="{DynamicResource TextFillColorSecondary}" />

    <Style x:Key="SgPrimaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SgSecondaryButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SgToolbarButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SgIconButtonStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SgRailItemStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="56" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Margin" Value="6,3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="SgRailItemSelectedStyle"
           TargetType="{x:Type Button}"
           BasedOn="{StaticResource SgRailItemStyle}">
        <Setter Property="BorderBrush" Value="{StaticResource SgAccentBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="SgSectionHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SgMutedTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{StaticResource SgMutedTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SgTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SgSubtitleTextStyle"
           TargetType="{x:Type TextBlock}"
           BasedOn="{StaticResource SgMutedTextStyle}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SgPanelBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SgBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="SgHomeCardStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource SgPanelBorderStyle}">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="MinWidth" Value="180" />
    </Style>

    <Style x:Key="SgShellIconTileStyle"
           TargetType="{x:Type Border}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{StaticResource SgCanvasBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SgBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="SgContextPanelStyle"
           TargetType="{x:Type Border}"
           BasedOn="{StaticResource SgPanelBorderStyle}">
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SgContextSectionStyle"
           TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="0,0,0,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="BorderBrush" Value="{StaticResource SgBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="SgToolbarBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{StaticResource SgPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource SgBorderBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
</ResourceDictionary>
