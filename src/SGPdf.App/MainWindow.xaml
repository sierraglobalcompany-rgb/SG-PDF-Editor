<Window x:Class="SGPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SG PDF Editor" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Abrir..." />
                <Separator />
                <MenuItem Header="_Salir" />
            </MenuItem>
            <MenuItem Header="_Editar" />
            <MenuItem Header="_Páginas" />
            <MenuItem Header="_Anotar" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="Scaffold inicial — motor PDF pendiente" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="LightGray">
                <TextBlock Margin="16" Text="Páginas" FontWeight="SemiBold" />
            </Border>

            <Grid Grid.Column="1" Background="#F3F3F3">
                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                           Text="Abrir un PDF" FontSize="24" Foreground="#666" />
            </Grid>

            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="LightGray">
                <TextBlock Margin="16" Text="Propiedades" FontWeight="SemiBold" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
