<Window x:Class="SGPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SG PDF Editor" Height="760" Width="1200"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem x:Name="OpenPdfMenuItem" Header="_Abrir..." Click="OpenPdf_Click" />
                <MenuItem x:Name="OpenZplMenuItem"
                          Header="Abrir _etiquetas ZPL..."
                          Click="OpenZpl_Click"
                          IsEnabled="{Binding IsEnabled, ElementName=OpenPdfMenuItem}" />
                <MenuItem x:Name="PrintPdfMenuItem" Header="_Imprimir..." Click="PrintPdf_Click" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Salir" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Editar" />
            <MenuItem Header="_Páginas" />
            <MenuItem Header="_Anotar" />
        </Menu>

        <Border x:Name="NavigationBar"
                DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="LightGray"
                Background="White"
                Visibility="Collapsed"
                IsVisibleChanged="NavigationBar_IsVisibleChanged">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="8">
                <Button x:Name="PreviousPageButton"
                        Content="← Anterior"
                        MinWidth="92"
                        Padding="10,4"
                        Click="PreviousPage_Click"
                        IsEnabled="False" />

                <StackPanel Orientation="Horizontal"
                            Margin="16,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Página"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="PageNumberTextBox"
                             Width="46"
                             Margin="6,0"
                             Padding="4,2"
                             Text="1"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             ToolTip="Escribe un número de página y presiona Enter"
                             KeyDown="PageNumberTextBox_KeyDown"
                             LostKeyboardFocus="PageNumberTextBox_LostKeyboardFocus"
                             IsEnabled="False" />
                    <TextBlock x:Name="PageCountText"
                               Text="de 1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Button x:Name="NextPageButton"
                        Content="Siguiente →"
                        MinWidth="92"
                        Padding="10,4"
                        Click="NextPage_Click"
                        IsEnabled="False" />

                <Border Width="1"
                        Height="24"
                        Margin="14,0"
                        Background="LightGray" />

                <Button x:Name="ZoomOutButton"
                        Content="−"
                        Width="34"
                        Padding="6,4"
                        ToolTip="Reducir"
                        Click="ZoomOut_Click"
                        IsEnabled="False" />
                <Button x:Name="ZoomPercentButton"
                        Content="100%"
                        MinWidth="58"
                        Margin="4,0"
                        Padding="8,4"
                        ToolTip="Tamaño real (100%)"
                        Click="ActualSize_Click"
                        IsEnabled="False" />
                <Button x:Name="ZoomInButton"
                        Content="+"
                        Width="34"
                        Padding="6,4"
                        ToolTip="Ampliar"
                        Click="ZoomIn_Click"
                        IsEnabled="False" />

                <Button x:Name="FitPageButton"
                        Content="Ajustar página"
                        Margin="12,0,4,0"
                        Padding="10,4"
                        ToolTip="Mostrar la página completa"
                        Click="FitPage_Click"
                        IsEnabled="False" />
                <Button x:Name="FitWidthButton"
                        Content="Ajustar ancho"
                        Padding="10,4"
                        ToolTip="Ajustar al ancho del visor"
                        Click="FitWidth_Click"
                        IsEnabled="False" />
            </StackPanel>
        </Border>

        <Border x:Name="LabelNavigationBar"
                DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="LightGray"
                Background="White"
                Visibility="Collapsed"
                IsEnabled="{Binding IsEnabled, ElementName=OpenPdfMenuItem}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="8">
                <Button x:Name="PreviousLabelButton"
                        Content="← Anterior"
                        MinWidth="92"
                        Padding="10,4"
                        Click="PreviousLabel_Click"
                        IsEnabled="False" />
                <TextBlock x:Name="LabelCountText"
                           Text="Etiqueta 0 de 0"
                           Margin="16,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button x:Name="NextLabelButton"
                        Content="Siguiente →"
                        MinWidth="92"
                        Padding="10,4"
                        Click="NextLabel_Click"
                        IsEnabled="False" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Listo" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="LightGray">
                <TextBlock Margin="16" Text="Páginas" FontWeight="SemiBold" />
            </Border>

            <Grid Grid.Column="1" Background="#F3F3F3">
                <ScrollViewer x:Name="PdfScrollViewer"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="PdfScrollViewer_SizeChanged">
                    <Image x:Name="PdfImage"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Stretch="None"
                           Visibility="Collapsed"
                           IsVisibleChanged="PdfImage_IsVisibleChanged" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyStateText"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="Abrir un PDF"
                           FontSize="24"
                           Foreground="#666" />
            </Grid>

            <Border Grid.Column="2"
                    BorderThickness="1,0,0,0"
                    BorderBrush="LightGray"
                    IsEnabled="{Binding IsEnabled, ElementName=OpenPdfMenuItem}">
                <Grid>
                    <TextBlock x:Name="PropertiesPlaceholderText"
                               Margin="16"
                               Text="Propiedades"
                               FontWeight="SemiBold" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LabelPropertiesPanel"
                                    Margin="16"
                                    Visibility="Collapsed">
                            <TextBlock Text="Propiedades de etiqueta"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       Margin="0,0,0,16" />

                            <TextBlock Text="Cantidad"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,8" />
                            <RadioButton x:Name="QuantityFromFileRadio"
                                         GroupName="LabelQuantity"
                                         Content="Del archivo"
                                         Margin="0,0,0,6"
                                         Checked="QuantityMode_Checked" />
                            <RadioButton x:Name="QuantityOneEachRadio"
                                         GroupName="LabelQuantity"
                                         Content="Una de cada"
                                         Margin="0,0,0,6"
                                         Checked="QuantityMode_Checked" />
                            <RadioButton x:Name="QuantityCustomRadio"
                                         GroupName="LabelQuantity"
                                         Content="Personalizada por diseño"
                                         Margin="0,0,0,6"
                                         Checked="QuantityMode_Checked" />
                            <TextBox x:Name="CustomQuantityTextBox"
                                     Width="110"
                                     HorizontalAlignment="Left"
                                     Margin="22,0,0,8"
                                     Padding="6,3"
                                     Text="1"
                                     TextChanged="CustomQuantityTextBox_TextChanged"
                                     IsEnabled="False" />
                            <TextBlock x:Name="OutputQuantityText"
                                       Text="Cantidad de salida: 0"
                                       Foreground="#555"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
