<Window x:Class="SGPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SG PDF Editor" Height="800" Width="1240"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Abrir PDF..." Click="OpenPdf_Click" />
                <MenuItem x:Name="PrintMenuItem" Header="_Imprimir..." IsEnabled="False" Click="PrintPdf_Click" />
                <Separator />
                <MenuItem Header="_Salir" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="PreviousPageButton" Content="◀" ToolTip="Página anterior"
                        IsEnabled="False" Click="PreviousPage_Click" />
                <TextBlock x:Name="PageText" Margin="8,0" VerticalAlignment="Center" Text="— / —" />
                <Button x:Name="NextPageButton" Content="▶" ToolTip="Página siguiente"
                        IsEnabled="False" Click="NextPage_Click" />
                <Separator />
                <Button x:Name="ZoomOutButton" Content="−" ToolTip="Alejar"
                        IsEnabled="False" Click="ZoomOut_Click" />
                <TextBlock x:Name="ZoomText" Width="54" TextAlignment="Center"
                           VerticalAlignment="Center" Text="100%" />
                <Button x:Name="ZoomInButton" Content="+" ToolTip="Acercar"
                        IsEnabled="False" Click="ZoomIn_Click" />
                <Separator />
                <Button x:Name="FitWidthButton" Content="Ajustar ancho"
                        IsEnabled="False" Click="FitWidth_Click" />
                <Button x:Name="FitPageButton" Content="Ajustar página"
                        IsEnabled="False" Click="FitPage_Click" />
                <Separator />
                <Button x:Name="PrintButton" Content="Imprimir"
                        IsEnabled="False" Click="PrintPdf_Click" />
                <Separator />
                <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="LEER" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Listo — abre un PDF para comenzar." />
        </StatusBar>

        <Grid Background="#ECECEC">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" BorderThickness="0,0,1,0" BorderBrush="#D5D5D5">
                <StackPanel Margin="14">
                    <TextBlock Text="Páginas" FontWeight="SemiBold" />
                    <TextBlock Margin="0,8,0,0" Foreground="#777" TextWrapping="Wrap"
                               Text="Miniaturas se incorporan en F4. F0 prioriza abrir, renderizar y navegar." />
                </StackPanel>
            </Border>

            <ScrollViewer x:Name="PdfScrollViewer" Grid.Column="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#D9D9D9">
                <Grid Margin="24">
                    <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Effect="{x:Null}">
                        <Image x:Name="PdfImage" Stretch="None" SnapsToDevicePixels="True" />
                    </Border>
                    <TextBlock x:Name="EmptyStateText"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="20" Text="Abrir un PDF" FontSize="24" Foreground="#666" />
                </Grid>
            </ScrollViewer>

            <Border Grid.Column="2" Background="White" BorderThickness="1,0,0,0" BorderBrush="#D5D5D5">
                <StackPanel Margin="14">
                    <TextBlock Text="Documento" FontWeight="SemiBold" />
                    <TextBlock x:Name="FileNameText" Margin="0,8,0,0" Foreground="#555" TextWrapping="Wrap" Text="Sin documento" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
