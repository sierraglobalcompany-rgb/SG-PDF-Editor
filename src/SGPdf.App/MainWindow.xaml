<Window x:Class="SGPdf.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SG PDF Editor" Height="760" Width="1200"
        MinHeight="640" MinWidth="960"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Closed="Window_Closed">
    <DockPanel>
        <!-- One V4 top-shell composition; named menu/reader commands retain their original handlers. -->
        <Border x:Name="DocumentTopShell" DockPanel.Dock="Top"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel x:Name="DocumentTabRow" Grid.Row="0"
                           MinHeight="44" LastChildFill="False"
                           Margin="12,4,8,0" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                Margin="0,0,12,0" VerticalAlignment="Center">
                        <Image x:Name="DocumentBrandIcon"
                               Width="28" Height="28" Stretch="Uniform" />
                        <TextBlock Text="SG PDF" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="7,0,0,0"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                    <TabControl x:Name="DocumentTabs" DockPanel.Dock="Left"
                                MinHeight="34" Background="Transparent" BorderThickness="0"
                                Style="{DynamicResource SgDocumentTabsStyle}"
                                AutomationProperties.Name="Documentos PDF abiertos" />
                    <Button x:Name="AddDocumentTabButton" DockPanel.Dock="Left"
                            Content="+" Width="32" Height="32" MinWidth="32"
                            Padding="0" Margin="3,0,0,0" VerticalAlignment="Center"
                            ToolTip="Abrir otro PDF" AutomationProperties.Name="Abrir otro PDF"
                            Style="{DynamicResource SgIconButtonStyle}" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="4,2,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
        <Menu Grid.Column="0"
              Background="Transparent">
            <MenuItem Header="_Archivo">
                <MenuItem x:Name="OpenPdfMenuItem" Header="_Abrir..." Click="OpenPdf_Click" />
                <MenuItem x:Name="OpenZplMenuItem"
                          Header="Abrir _etiquetas ZPL..."
                          Click="OpenZpl_Click"
                          IsEnabled="{Binding IsEnabled, ElementName=OpenPdfMenuItem}" />
                <MenuItem x:Name="RecentFilesMenuItem"
                          Header="_Recientes"
                          SubmenuOpened="RecentFilesMenuItem_SubmenuOpened">
                    <MenuItem x:Name="ClearRecentFilesMenuItem"
                              Header="_Borrar recientes"
                              Click="ClearRecentFilesMenuItem_Click"
                              IsEnabled="False" />
                </MenuItem>
                <MenuItem x:Name="PrintPdfMenuItem" Header="_Imprimir..." Click="PrintPdf_Click" IsEnabled="False" />
                <Separator />
                <MenuItem Header="_Salir" Click="Exit_Click" />
            </MenuItem>
            <MenuItem x:Name="EditMenuItem" Header="_Editar" />
            <MenuItem Header="_Ver" />
            <MenuItem x:Name="UtilitiesMenuItem" Header="_Herramientas" />
            <MenuItem Header="_Ayuda" />
        </Menu>

        <Border x:Name="NavigationBar"
                Grid.Column="1"
                Style="{DynamicResource SgToolbarBorderStyle}"
                HorizontalAlignment="Stretch"
                Visibility="Collapsed"
                IsVisibleChanged="NavigationBar_IsVisibleChanged">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="5,3">
                <Button x:Name="PreviousPageButton"
                        Content="‹"
                        MinWidth="32"
                        Style="{DynamicResource SgToolbarButtonStyle}"
                        Click="PreviousPage_Click"
                        IsEnabled="False" />

                <StackPanel Orientation="Horizontal"
                            Margin="8,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="Página"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="PageNumberTextBox"
                             Width="48"
                             MinHeight="32"
                             Margin="8,0"
                             Text="1"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             ToolTip="Escribe un número de página y presiona Enter"
                             KeyDown="PageNumberTextBox_KeyDown"
                             LostKeyboardFocus="PageNumberTextBox_LostKeyboardFocus"
                             IsEnabled="False" />
                    <TextBlock x:Name="PageCountText"
                               Text="de 1"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold" />
                </StackPanel>

                <Button x:Name="NextPageButton"
                        Content="›"
                        MinWidth="32"
                        Style="{DynamicResource SgToolbarButtonStyle}"
                        Click="NextPage_Click"
                        IsEnabled="False" />

                <Border Width="1"
                        Height="24"
                        Margin="8,0"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <Button x:Name="ZoomOutButton"
                        Content="−"
                        Style="{DynamicResource SgIconButtonStyle}"
                        ToolTip="Reducir"
                        Click="ZoomOut_Click"
                        IsEnabled="False" />
                <Button x:Name="ZoomPercentButton"
                        Content="100%"
                        MinWidth="54"
                        Style="{DynamicResource SgToolbarButtonStyle}"
                        ToolTip="Tamaño real (100%)"
                        Click="ActualSize_Click"
                        IsEnabled="False" />
                <Button x:Name="ZoomInButton"
                        Content="+"
                        Style="{DynamicResource SgIconButtonStyle}"
                        ToolTip="Ampliar"
                        Click="ZoomIn_Click"
                        IsEnabled="False" />

                <Border Width="1" Height="24" Margin="8,0"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}" />

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="FitPageButton"
                            Content="Página"
                            Margin="2,0"
                            Style="{DynamicResource SgToolbarButtonStyle}"
                            ToolTip="Mostrar la página completa"
                            Click="FitPage_Click"
                            IsEnabled="False" />
                    <Button x:Name="FitWidthButton"
                            Content="Ancho"
                            Margin="2,0"
                            Style="{DynamicResource SgToolbarButtonStyle}"
                            ToolTip="Ajustar al ancho del visor"
                            Click="FitWidth_Click"
                            IsEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Border>

                </Grid>
            </Grid>
        </Border>

        <Border x:Name="LabelNavigationBar"
                DockPanel.Dock="Top"
                Style="{DynamicResource SgToolbarBorderStyle}"
                Visibility="Collapsed"
                IsEnabled="{Binding IsEnabled, ElementName=OpenPdfMenuItem}">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="12,8">
                <Button x:Name="PreviousLabelButton"
                        Content="← Anterior"
                        MinWidth="96"
                        Style="{DynamicResource SgToolbarButtonStyle}"
                        Click="PreviousLabel_Click"
                        IsEnabled="False" />
                <TextBlock x:Name="LabelCountText"
                           Text="Etiqueta 0 de 0"
                           Margin="18,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <Button x:Name="NextLabelButton"
                        Content="Siguiente →"
                        MinWidth="96"
                        Style="{DynamicResource SgToolbarButtonStyle}"
                        Click="NextLabel_Click"
                        IsEnabled="False" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Height="28" Padding="12,0"
                   Background="{DynamicResource ApplicationBackgroundBrush}">
            <TextBlock x:Name="StatusText" Text="Listo" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ContextPropertiesColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <TextBlock Margin="16,18"
                           Text="Páginas"
                           Style="{DynamicResource SgSectionHeaderStyle}" />
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource LayerFillColorAltBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="ReaderContextBar" Grid.Row="0"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,6" MinHeight="44" Visibility="Collapsed">
                    <TextBlock x:Name="ReaderViewCaption"
                               Text="Vista del documento" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ScrollViewer x:Name="PdfScrollViewer"
                              Grid.Row="1"
                              Background="{DynamicResource LayerFillColorAltBrush}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              SizeChanged="PdfScrollViewer_SizeChanged">
                    <Grid>
                        <Image x:Name="PdfImage"
                               Margin="24"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Stretch="None"
                               Visibility="Collapsed"
                               IsVisibleChanged="PdfImage_IsVisibleChanged" />
                        <Canvas x:Name="LabelSheetCanvas"
                                Margin="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="White"
                                Visibility="Collapsed" />
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="EmptyStateText"
                           Grid.Row="1"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Text="Abre un PDF para empezar"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Style="{DynamicResource SgMutedTextStyle}" />
            </Grid>

            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    IsEnabled="{Binding IsEnabled, ElementName=OpenPdfMenuItem}">
                <Grid>
                    <TextBlock x:Name="PropertiesPlaceholderText"
                               Margin="16,18"
                               Text=""
                               Visibility="Collapsed"
                               Style="{DynamicResource SgSectionHeaderStyle}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LabelPropertiesPanel"
                                    Margin="18"
                                    Visibility="Collapsed">
                            <TextBlock Text="Propiedades de etiqueta"
                                       FontSize="16"
                                       Style="{DynamicResource SgSectionHeaderStyle}"
                                       Margin="0,0,0,16" />

                            <TextBlock Text="Vista previa"
                                       Style="{DynamicResource SgSectionHeaderStyle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <RadioButton x:Name="PreviewLabelRadio"
                                             GroupName="LabelPreviewMode"
                                             Content="Etiqueta"
                                             IsChecked="True"
                                             Margin="0,0,16,0"
                                             Checked="PreviewMode_Checked" />
                                <RadioButton x:Name="PreviewSheetRadio"
                                             GroupName="LabelPreviewMode"
                                             Content="Hoja"
                                             IsEnabled="False"
                                             Checked="PreviewMode_Checked" />
                            </StackPanel>

                            <Separator Margin="0,12,0,14" />

                            <TextBlock Text="Cantidad"
                                       Style="{DynamicResource SgSectionHeaderStyle}" />
                            <RadioButton x:Name="QuantityFromFileRadio"
                                         GroupName="LabelQuantity"
                                         Content="Del archivo"
                                         Margin="0,0,0,6"
                                         Checked="QuantityMode_Checked" />
                            <RadioButton x:Name="QuantityOneEachRadio"
                                         GroupName="LabelQuantity"
                                         Content="Una de cada"
                                         Margin="0,0,0,6"
                                         Checked="QuantityMode_Checked" />
                            <RadioButton x:Name="QuantityCustomRadio"
                                         GroupName="LabelQuantity"
                                         Content="Personalizada por diseño"
                                         Margin="0,0,0,6"
                                         Checked="QuantityMode_Checked" />
                            <TextBox x:Name="CustomQuantityTextBox"
                                     Width="110"
                                     HorizontalAlignment="Left"
                                     Margin="22,0,0,8"
                                     Text="1"
                                     TextChanged="CustomQuantityTextBox_TextChanged"
                                     IsEnabled="False" />
                            <TextBlock x:Name="OutputQuantityText"
                                       Text="Cantidad de salida: 0"
                                       Style="{DynamicResource SgMutedTextStyle}" />

                            <Separator Margin="0,16,0,14" />

                            <TextBlock Text="Tamaño de etiqueta"
                                       Style="{DynamicResource SgSectionHeaderStyle}" />
                            <ComboBox x:Name="LabelSizeComboBox"
                                      SelectedIndex="0"
                                      SelectionChanged="LabelSizeComboBox_SelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="102 × 152 mm (4 × 6 in)" />
                                <ComboBoxItem Content="100 × 150 mm" />
                                <ComboBoxItem Content="100 × 100 mm" />
                                <ComboBoxItem Content="Personalizado" />
                            </ComboBox>

                            <StackPanel x:Name="CustomSizePanel"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,10">
                                <TextBlock Text="Ancho (mm)" Margin="0,0,0,4" />
                                <TextBox x:Name="CustomWidthTextBox"
                                         Width="110"
                                         HorizontalAlignment="Left"
                                         Text="102"
                                         Margin="0,0,0,8" />
                                <TextBlock Text="Alto (mm)" Margin="0,0,0,4" />
                                <TextBox x:Name="CustomHeightTextBox"
                                         Width="110"
                                         HorizontalAlignment="Left"
                                         Text="152"
                                         Margin="0,0,0,8" />
                                <Button x:Name="ApplyCustomSizeButton"
                                        Content="Aplicar tamaño"
                                        HorizontalAlignment="Left"
                                        Style="{DynamicResource SgToolbarButtonStyle}"
                                        Click="ApplyCustomSize_Click" />
                            </StackPanel>

                            <TextBlock Text="Resolución"
                                       Style="{DynamicResource SgSectionHeaderStyle}"
                                       Margin="0,4,0,8" />
                            <ComboBox x:Name="LabelDpmmComboBox"
                                      SelectedIndex="1"
                                      SelectionChanged="LabelDpmmComboBox_SelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="6 dpmm (~152 dpi)" />
                                <ComboBoxItem Content="8 dpmm (~203 dpi)" />
                                <ComboBoxItem Content="12 dpmm (~300 dpi)" />
                                <ComboBoxItem Content="24 dpmm (~600 dpi)" />
                            </ComboBox>

                            <TextBlock x:Name="RenderSettingsText"
                                       Text="102 × 152 mm · 8 dpmm (~203 dpi)"
                                       Style="{DynamicResource SgMutedTextStyle}" />

                            <Separator Margin="0,16,0,14" />

                            <TextBlock Text="Hoja / salida"
                                       Style="{DynamicResource SgSectionHeaderStyle}" />
                            <TextBlock Text="Medio" Margin="0,0,0,4" />
                            <ComboBox x:Name="SheetMediaComboBox"
                                      SelectedIndex="0"
                                      SelectionChanged="SheetInputSelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="Térmica (tamaño exacto)" />
                                <ComboBoxItem Content="A4 — 210 × 297 mm" />
                                <ComboBoxItem Content="Carta — 215.9 × 279.4 mm" />
                                <ComboBoxItem Content="Personalizado" />
                            </ComboBox>

                            <StackPanel x:Name="CustomSheetSizePanel"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,8">
                                <TextBlock Text="Ancho de hoja (mm)" Margin="0,0,0,4" />
                                <TextBox x:Name="CustomSheetWidthTextBox"
                                         Width="110"
                                         HorizontalAlignment="Left"
                                         Text="210"
                                         Margin="0,0,0,6" />
                                <TextBlock Text="Alto de hoja (mm)" Margin="0,0,0,4" />
                                <TextBox x:Name="CustomSheetHeightTextBox"
                                         Width="110"
                                         HorizontalAlignment="Left"
                                         Text="297" />
                            </StackPanel>

                            <TextBlock Text="Orientación" Margin="0,0,0,4" />
                            <ComboBox x:Name="SheetOrientationComboBox"
                                      SelectedIndex="0"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="Vertical" />
                                <ComboBoxItem Content="Horizontal" />
                            </ComboBox>

                            <TextBlock Text="Etiquetas por hoja" Margin="0,0,0,4" />
                            <ComboBox x:Name="SheetLayoutComboBox"
                                      SelectedIndex="0"
                                      SelectionChanged="SheetInputSelectionChanged"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                                <ComboBoxItem Content="6" />
                                <ComboBoxItem Content="8" />
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="12" />
                                <ComboBoxItem Content="Personalizado" />
                            </ComboBox>

                            <StackPanel x:Name="CustomSheetGridPanel"
                                        Visibility="Collapsed"
                                        Margin="0,0,0,8">
                                <TextBlock Text="Filas" Margin="0,0,0,4" />
                                <TextBox x:Name="CustomSheetRowsTextBox"
                                         Width="80"
                                         HorizontalAlignment="Left"
                                         Text="2"
                                         Margin="0,0,0,6" />
                                <TextBlock Text="Columnas" Margin="0,0,0,4" />
                                <TextBox x:Name="CustomSheetColumnsTextBox"
                                         Width="80"
                                         HorizontalAlignment="Left"
                                         Text="2" />
                            </StackPanel>

                            <TextBlock Text="Rotación de etiqueta" Margin="0,0,0,4" />
                            <ComboBox x:Name="SheetRotationComboBox"
                                      SelectedIndex="0"
                                      Margin="0,0,0,8">
                                <ComboBoxItem Content="0°" />
                                <ComboBoxItem Content="90°" />
                            </ComboBox>

                            <TextBlock Text="Margen horizontal (mm)" Margin="0,0,0,4" />
                            <TextBox x:Name="SheetHorizontalMarginTextBox"
                                     Text="0"
                                     Margin="0,0,0,6" />
                            <TextBlock Text="Margen vertical (mm)" Margin="0,0,0,4" />
                            <TextBox x:Name="SheetVerticalMarginTextBox"
                                     Text="0"
                                     Margin="0,0,0,6" />
                            <TextBlock Text="Separación horizontal (mm)" Margin="0,0,0,4" />
                            <TextBox x:Name="SheetHorizontalGapTextBox"
                                     Text="0"
                                     Margin="0,0,0,6" />
                            <TextBlock Text="Separación vertical (mm)" Margin="0,0,0,4" />
                            <TextBox x:Name="SheetVerticalGapTextBox"
                                     Text="0"
                                     Margin="0,0,0,10" />

                            <Button x:Name="ApplySheetLayoutButton"
                                    Content="Aplicar layout"
                                    HorizontalAlignment="Left"
                                    Style="{DynamicResource SgToolbarButtonStyle}"
                                    Click="ApplySheetLayout_Click" />

                            <TextBlock x:Name="LayoutValidationText"
                                       Margin="0,8,0,0"
                                       Foreground="DarkRed"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed" />

                            <Button x:Name="ExportLabelPdfButton"
                                    Content="Guardar como PDF..."
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    Style="{DynamicResource SgPrimaryButtonStyle}"
                                    IsEnabled="False"
                                    Click="ExportLabelPdf_Click" />

                            <Button x:Name="PrintLabelButton"
                                    Content="Imprimir etiquetas..."
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"
                                    Style="{DynamicResource SgToolbarButtonStyle}"
                                    IsEnabled="False"
                                    Click="PrintLabels_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
